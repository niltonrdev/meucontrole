rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function ehDono(userId) {
      return autenticado() && request.auth.uid == userId;
    }

    function lancamentoValido(lancamentoId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'tipo', 'data', 'valorCentavos', 'contaId', 'categoria',
          'formaPagamento', 'descricao', 'reembolsoAReceber', 'itens'
        ])
        && d.keys().hasAll([
          'id', 'tipo', 'data', 'valorCentavos', 'contaId', 'categoria',
          'formaPagamento', 'descricao', 'reembolsoAReceber'
        ])
        && d.id is string
        && d.id == lancamentoId
        && d.tipo in ['entrada', 'saida', 'transferencia', 'ajuste']
        && d.data is string
        && d.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.valorCentavos is int
        && d.contaId is string
        && d.contaId.size() > 0
        && d.categoria in ['comida_fora', 'mercado', 'transporte', 'lazer', 'outros']
        && d.formaPagamento is string
        && d.descricao is string
        && d.reembolsoAReceber is bool
        && (!('itens' in d) || itensValido(d.itens));
    }

    function itensValido(itens) {
      return itens is list;
    }

    // Documento do usuário: o app atual lê com onSnapshot e grava com setDoc
    // o mapa inteiro (chaves 'ano-mês' → lista de gastos fixos).
    // Sem validação rígida deste mapa para não quebrar o formato legado.
    match /users/{userId} {
      allow read, create, update, delete: if ehDono(userId);

      match /lancamentos/{lancamentoId} {
        allow read, delete: if ehDono(userId);
        allow create, update: if ehDono(userId) && lancamentoValido(lancamentoId);
      }
    }
  }
}
