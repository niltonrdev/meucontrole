{
  "name": "meucontrole",
  "private": true,
  "type": "module",
  "description": "Dev/testes locais. Produção na Vercel continua sendo site estático (sem build).",
  "scripts": {
    "test": "node --test tests/modelo.test.js",
    "test:regras": "firebase emulators:exec --only firestore --project demo-meucontrole \"node --test tests/regras.test.js\"",
    "test:tudo": "npm test && npm run test:regras"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.2",
    "firebase-tools": "^13.29.1"
  }
}
